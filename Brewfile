# The whole CLI toolbox for a fresh Mac: `make brew` (= brew bundle --file Brewfile).
# Deliberately small. Add a line the first time a project actually needs a tool,
# not before. Databases, VMs and heavy builds live on the always-on machines.

# shell + git
brew "git"
brew "gh"
brew "tig"
brew "fzf"
brew "zoxide"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "coreutils"
brew "gnu-sed"
brew "gawk"
brew "tmux"

# languages: node for the JS tools, uv for every Python (it installs interpreters too)
brew "node"
brew "uv"

# reading + utilities
brew "yazi"
brew "fd"
brew "glow"
brew "jq"
brew "shellcheck"
brew "pandoc"
brew "poppler"
brew "ffmpeg"
brew "yt-dlp"
brew "gitleaks"

# networking: Tailscale reaches the other Macs and the box
brew "tailscale"
brew "cloudflared"

# GUI
cask "ghostty"
cask "font-caskaydia-cove-nerd-font"
cask "font-symbols-only-nerd-font"
